+
+#include <common.h>
+#include <malloc.h>
+#include <command.h>
+#include <pci.h>
+#include <netdev.h>
+#include <asm/processor.h>
+#include <asm/mmu.h>
+#include "articiaS.h"
+#include "memio.h"
+#include "via686.h"
+
+__asm__(" .globl send_kb				\n "
+	"send_kb:					\n "
+	"	lis	r9, 0xfe00			\n "
+	"						\n "
+	"	li	r4, 0x10	# retries	\n "
+	"	mtctr	r4				\n "
+	"						\n "
+	"idle:						\n "
+	"	lbz	r4, 0x64(r9)			\n "
+	"	andi.	r4, r4, 0x02			\n "
+	"	bne	idle				\n "
+
+	"ready:						\n "
+	"	stb	r3, 0x60(r9)			\n "
+	"						\n "
+	"check:						\n "
+	"	lbz	r4, 0x64(r9)			\n "
+	"	andi.	r4, r4, 0x01			\n "
+	"	beq	check				\n "
+	"						\n "
+	"	lbz	r4, 0x60(r9)			\n "
+	"	cmpwi	r4, 0xfa			\n "
+	"	beq	done				\n "
+
+	"	bdnz	idle				\n "
+
+	"	li	r3, 0				\n "
+	"	blr					\n "
+
+	"done:						\n "
+	"	li	r3, 1				\n "
+	"	blr					\n "
+
+	".globl test_kb					\n "
+	"test_kb:					\n "
+	"	mflr	r10				\n "
+	"	li	r3, 0xed			\n "
+	"	bl	send_kb				\n "
+	"	li	r3, 0x01			\n "
+	"	bl	send_kb				\n "
+	"	mtlr	r10				\n "
+	"	blr					\n "
+);
+
+
+/* used by the ACube video, menu and boot code */
+unsigned char model_value = 0;
+char *chipset_name = NULL;
+u8 *logo_buf8 = NULL;
+u16 *logo_buf16 = NULL;
+
+extern struct pci_controller articiaS_hose;
+extern int init_radeon(struct pci_controller *hose);
+
+extern int drv_isa_kbd_init(void);
+
+int last_stage_init(void)
+{
+	char *s = getenv("menuboot_cmd");
+
+	drv_isa_kbd_init();
+	if (!s || strlen(s) < 3 || !strcmp(s, "noboot")) {
+		setenv("menuboot_cmd", "boota");
+	}
+	/*
+	 * The ACube console takes the colour of its text from a logo the
+	 * size of the screen. There is no logo here: a white one gives white
+	 * text on black at the 640x480 the VGA card is set to.
+	 */
+	logo_buf8 = malloc(640 * 480);
+	logo_buf16 = malloc(640 * 480 * 2);
+	if (logo_buf8 && logo_buf16) {
+		memset(logo_buf8, 0xff, 640 * 480);
+		memset(logo_buf16, 0xff, 640 * 480 * 2);
+	}
+	/* the VGA card, through its video BIOS */
+	init_radeon(&articiaS_hose);
+	return 0;
+}
+
+int checkboard (void)
+{
+	printf ("Board: AmigaOneG3SE\n");
+	return 0;
+}
+
+phys_size_t initdram (int board_type)
+{
+	return articiaS_ram_init ();
+}
+
+
+void after_reloc (ulong dest_addr, gd_t *gd)
+{
+	board_init_r (gd, dest_addr);
+}
+
+
+int misc_init_r (void)
+{
+	/*
+	 * DBAT1 maps PCI memory at 0x80000000-0x8fffffff, but with more than
+	 * the video card the BARs go above it. The init RAM is not used after
+	 * relocation, so its BAT maps the next 256 MiB.
+	 */
+	mtspr(DBAT2U, 0);
+	mtspr(DBAT2L, 0x90000000 | BATL_PP_RW | BATL_CACHEINHIBIT |
+		      BATL_GUARDEDSTORAGE);
+	mtspr(DBAT2U, 0x90000000 | BATU_BL_256M | BATU_VS | BATU_VP);
+	__asm__ __volatile__("isync");
+	return (0);
+}
+
+
+void pci_init_board (void)
+{
+#ifndef CONFIG_RAMBOOT
+	articiaS_pci_init ();
+#endif
+}
+
+int board_eth_init(bd_t *bis)
+{
+#if defined(CONFIG_3COM)
+	eth_3com_initialize(bis);
+#endif
+	return 0;
+}
