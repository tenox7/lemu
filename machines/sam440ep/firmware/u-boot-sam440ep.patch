+/*
+ * Under QEMU, the MAC addresses of the two EMACs are in bytes 0xf0-0xfb of
+ * the boot EEPROM at 0x53. Use them when the environment has none, and save
+ * the environment: AmigaOS reads ethaddr and eth1addr from the saved one.
+ */
 int misc_init_r (void)
 {
+	uchar mac[12];
+	int i, set = 0;
+
+	if (i2c_read(0x53, 0xf0, 1, mac, sizeof(mac)) == 0) {
+		for (i = 0; i < 2; i++) {
+			const char *var = i ? "eth1addr" : "ethaddr";
+
+			if (!getenv(var) && is_valid_ether_addr(mac + i * 6)) {
+				eth_setenv_enetaddr((char *)var, mac + i * 6);
+				set = 1;
+			}
+		}
+	}
+	if (set)
+		saveenv();
 	return 0;
 }
 
