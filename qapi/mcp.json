##
# @McpMediaAction:
#     What to do with removable media.
#
# @list: list removable drives and what is in them
#
# @insert: insert @file, or a new medium made from @files (closes the
#     tray)
#
# @eject: eject the medium (opens the tray)
#
# @copy-out: copy the files on the floppy in @device into the host
#     folder @to; let the guest finish writing first (unmount it, or
#     wait for the drive light)
#
# Since: 11.2
##
{ 'enum': 'McpMediaAction',
  'data': [ 'list', 'insert', 'eject', 'copy-out' ] }

##
# @McpMediaResult:
#     What @media returns.
#
# @drives: the removable drives
#
# Since: 11.2
##
{ 'struct': 'McpMediaResult',
  'base': 'McpResult',
  'data': { 'drives': [ 'McpDiskInfo' ] } }

##
# @media:
#     List, insert or eject CD-ROM and floppy media.  Also moves files
#     in and out of a guest with no network: insert a medium made from
#     host files, or copy the files off a floppy the guest wrote.
#
# @action: what to do
#
# @device: the drive, as listed (needed for all but list)
#
# @file: the image file to insert
#
# @files: host files and folders to insert instead of @file, on a new
#     medium: a CD-ROM drive gets a disc (ISO 9660: 8.3 names, and the
#     real names in guests that read Rock Ridge), other drives a 1.44
#     MB floppy (FAT12, 8.3 names).  An empty list gives a blank
#     floppy for the guest to write to.  The medium is deleted when
#     the drive gets another one or is emptied, so copy-out first
#
# @to: the host folder that copy-out writes to (made if needed)
#
# @format: image format, e.g. "raw" (default: probed)
#
# @read-only: open the image read-only (default: true for CD-ROMs)
#
# @force: eject even if the guest locked the tray (default: false)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'media',
  'data': { 'action': 'McpMediaAction', '*device': 'str', '*file': 'str',
            '*files': [ 'str' ], '*to': 'str', '*format': 'str',
            '*read-only': 'bool', '*force': 'bool' },
  'returns': 'McpMediaResult',
  'features': [ 'mcp' ] }

##
# @McpPowerAction:
#     What to do with the VM.
#
# @pause: stop the guest CPUs
#
# @resume: continue a paused guest
#
# @reset: hard reset, like the reset button
#
# @powerdown: ask the guest to shut down (ACPI power button)
#
# @quit: end the emulator at once, without a guest shutdown
#
# Since: 11.2
##
{ 'enum': 'McpPowerAction',
  'data': [ 'pause', 'resume', 'reset', 'powerdown', 'quit' ] }

##
# @vm-power:
#     Pause, resume, reset, power down or quit the VM.  Never do this
#     to a VM you did not start unless the user asked.
#
# @action: what to do
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-destructive: may lose guest state
#
# Since: 11.2
##
{ 'command': 'vm-power',
  'data': { 'action': 'McpPowerAction' },
  'returns': 'McpResult',
  'features': [ 'mcp', 'mcp-destructive' ] }

##
# @McpSerialResult:
#     What a serial tool returns.  The text itself is in the summary.
#
# @port: the port
#
# @cursor: offset after the returned text; pass it to the next
#     serial-read or serial-expect
#
# @start: offset where the returned text starts
#
# @lost: bytes that were too old to keep, between the cursor that was
#     asked for and @start
#
# @matched: serial-expect: the pattern matched
#
# @match: serial-expect: the text that matched
#
# Since: 11.2
##
{ 'struct': 'McpSerialResult',
  'base': 'McpResult',
  'data': { 'port': 'str', 'cursor': 'int', 'start': 'int',
            '*lost': 'int', '*matched': 'bool', '*match': 'str' } }

##
# @serial-read:
#     Read what the guest wrote to a serial port, without using it up.
#     lemu keeps the last 1 MB of each port.  Offsets count every
#     byte since the VM started.
#
# @port: "serial0", "serial1", ..., a chardev id, or a telnet session
#     from serial-connect (default: serial0)
#
# @cursor: offset to read from (default: where the last serial-read
#     or serial-expect stopped, or where the last serial-write
#     started)
#
# @max-bytes: at most this much, up to 16384 (default: 4096)
#
# @strip-ansi: remove terminal escape sequences (default: true)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-read-only: does not change the VM
#
# Since: 11.2
##
{ 'command': 'serial-read',
  'data': { '*port': 'str', '*cursor': 'int', '*max-bytes': 'int',
            '*strip-ansi': 'bool' },
  'returns': 'McpSerialResult',
  'features': [ 'mcp', 'mcp-read-only' ] }

##
# @serial-write:
#     Send text to a serial port, as if typed on a terminal.  Old
#     Unix consoles want "\r" to end a line.  The next serial-expect
#     and serial-read look only at what the guest writes from now on;
#     give them a cursor to look further back.
#
# @port: "serial0", "serial1", ..., a chardev id, or a telnet session
#     from serial-connect (default: serial0)
#
# @text: the text
#
# @escapes: turn \r, \n, \t, \e, \\ and \xHH in @text into the
#     characters they name (default: true)
#
# @char-delay-ms: pause after each character, for slow guests
#     (default: 0)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'serial-write',
  'data': { '*port': 'str', 'text': 'str', '*escapes': 'bool',
            '*char-delay-ms': 'int' },
  'returns': 'McpResult',
  'features': [ 'mcp' ],
  'coroutine': true }

##
# @serial-expect:
#     Wait until serial output matches a regular expression.  Returns
#     the text up to the end of the match and the cursor after it.
#     Use "(?i)" for case-insensitive matching.
#
# @port: "serial0", "serial1", ..., a chardev id, or a telnet session
#     from serial-connect (default: serial0)
#
# @pattern: a regular expression (PCRE)
#
# @cursor: offset to search from (default: where the last
#     serial-read or serial-expect stopped, or where the last
#     serial-write started; a failed serial-expect leaves it there)
#
# @timeout-ms: give up after this long, at most 1500000, 25 minutes
#     (default: 30000)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-read-only: does not change the VM
#
# Since: 11.2
##
{ 'command': 'serial-expect',
  'data': { '*port': 'str', 'pattern': 'str', '*cursor': 'int',
            '*timeout-ms': 'int' },
  'returns': 'McpSerialResult',
  'features': [ 'mcp', 'mcp-read-only' ],
  'coroutine': true }

##
# @McpShell:
#     What reads the line that serial-run types.
#
# @sh: the Bourne shell or one of its kin (ksh, bash, POSIX sh); the
#     exit status is in $?
#
# @csh: csh or tcsh; the exit status is in $status
#
# @none: anything else, such as a ROM monitor, DOS or VMS: there is no
#     exit status, and the prompt marks the end of the output
#
# Since: 11.2
##
{ 'enum': 'McpShell', 'data': [ 'sh', 'csh', 'none' ] }

##
# @McpSerialRunResult:
#     What serial-run returns.  The output itself is in the summary.
#
# @port: the port
#
# @done: the command finished; false if it was still running at the
#     timeout
#
# @exit-status: the command's exit status, if the shell gave one
#
# @lines: lines of output, also those not shown
#
# @start: offset where the output starts; serial-read from here gets
#     all of it
#
# @cursor: offset after the output and the end marker
#
# @end-pattern: while not @done, the regular expression that marks the
#     end; wait for it with serial-expect
#
# Since: 11.2
##
{ 'struct': 'McpSerialRunResult',
  'base': 'McpResult',
  'data': { 'port': 'str', 'done': 'bool', '*exit-status': 'int',
            'lines': 'int', 'start': 'int', 'cursor': 'int',
            '*end-pattern': 'str' } }

##
# @serial-run:
#     Run one command line in a shell that waits at its prompt on a
#     serial port, and return the output and the exit status.  lemu
#     types the line with an end marker after it, waits for the marker
#     and cuts off the echo.  Log in first with serial-write and
#     serial-expect.  To stop a command that hangs, send "\x03"
#     (Ctrl-C) with serial-write.  Calls on one port take turns, and
#     wait for the end of a command that an earlier call left running
#     (after its timeout or a cancel), unless serial-write was used
#     since.
#
# @port: "serial0", "serial1", ..., a chardev id, or a telnet session
#     from serial-connect (default: serial0)
#
# @command: one line, without "\r" at the end
#
# @shell: what reads the line (default: sh)
#
# @prompt: for shell "none" only: a regular expression for the prompt
#     that follows the output
#
# @timeout-ms: give up waiting after this long, at most 1500000, 25
#     minutes (default: 30000)
#
# @max-lines: show at most this many lines of output (default: 200)
#
# @tail: show the last lines instead of the first (default: false)
#
# @line-limit: the longest line the guest takes, end marker included;
#     many old Unix terminals cut lines at 255 bytes (default: 255)
#
# @char-delay-ms: pause after each character, for slow guests
#     (default: 0)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'serial-run',
  'data': { '*port': 'str', 'command': 'str', '*shell': 'McpShell',
            '*prompt': 'str', '*timeout-ms': 'int', '*max-lines': 'int',
            '*tail': 'bool', '*line-limit': 'int',
            '*char-delay-ms': 'int' },
  'returns': 'McpSerialRunResult',
  'features': [ 'mcp' ],
  'coroutine': true }

##
# @serial-connect:
#     Open a telnet session and use it like a serial port: give the
#     port name this returns to serial-read, serial-write,
#     serial-expect and serial-run.  For guests whose console is the
#     screen, or for a second shell.  With user networking, connect to
#     the host port that is forwarded to the guest's port 23; to make
#     one, use hmp "hostfwd_add tcp:127.0.0.1:2323-:23".  lemu answers
#     the telnet options itself (terminal type VT100).  When the guest
#     ends the session, the serial tools say so; connect again for a
#     new one.  The summary shows what the guest sent first, such as
#     its login prompt.
#
# @address: host:port, a host (port 23), or just a port on 127.0.0.1
#
# @close: end the session instead (default: false)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'serial-connect',
  'data': { 'address': 'str', '*close': 'bool' },
  'returns': 'McpSerialResult',
  'features': [ 'mcp' ],
  'coroutine': true }

##
# @McpTextHighlight:
#     A run of text in a different background colour from most of the
