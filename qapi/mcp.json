# @load: go back to snapshot @name; what happened since is lost
#
# @delete: delete snapshot @name
#
# Since: 11.2
##
{ 'enum': 'McpSnapshotAction', 'data': [ 'list', 'save', 'load', 'delete' ] }

##
# @McpSnapshotInfo:
#
# @name: snapshot name
#
# @date: when it was taken, as "YYYY-MM-DD HH:MM:SS" local time
#
# @vm-state-size: bytes of saved RAM and device state
#
# Since: 11.2
##
{ 'struct': 'McpSnapshotInfo',
  'data': { 'name': 'str', 'date': 'str', 'vm-state-size': 'int' } }

##
# @McpSnapshotResult:
#
# @snapshots: the snapshots after the action
#
# Since: 11.2
##
{ 'struct': 'McpSnapshotResult',
  'base': 'McpResult',
  'data': { 'snapshots': [ 'McpSnapshotInfo' ] } }

##
# @vm-snapshot:
#     Save, load, list or delete whole-VM snapshots (RAM, devices and
#     disks).  Needs writable qcow2 disks.  Save one before a risky
#     step, load it to go back.
#
# @action: what to do
#
# @name: the snapshot (needed for save, load and delete)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-destructive: load and delete lose state
#
# Since: 11.2
##
{ 'command': 'vm-snapshot',
  'data': { 'action': 'McpSnapshotAction', '*name': 'str' },
  'returns': 'McpSnapshotResult',
  'features': [ 'mcp', 'mcp-destructive' ] }

##
# @McpFrameInfo:
#
# @frame: frame number; screenshot takes it as @frame
#
# @ago-ms: how long ago it appeared
#
# @shown-ms: how long it was on screen (so far, for the current one)
#
# @current: it is on screen now
#
# @box: where the next frame changed it
#
# @changed-pixels: how many pixels the next frame changed
#
# @width: its width, if a mode change replaced it
#
# @height: its height, if a mode change replaced it
#
# Since: 11.2
##
{ 'struct': 'McpFrameInfo',
  'data': { 'frame': 'int', 'ago-ms': 'int', 'shown-ms': 'int',
            'current': 'bool', '*box': 'ScreenRegion',
            '*changed-pixels': 'int', '*width': 'int', '*height': 'int' },
  'if': 'CONFIG_PIXMAN' }

##
# @McpFramesResult:
#
# @frames: newest first
#
# Since: 11.2
##
{ 'struct': 'McpFramesResult',
  'base': 'McpResult',
  'data': { 'frames': [ 'McpFrameInfo' ] },
  'if': 'CONFIG_PIXMAN' }

##
# @frames:
#     List the recent distinct screens, newest first, so you can find
#     one that went by too fast (a boot banner, an error box).  Fetch
#     one in full with screenshot's @frame.  Blinking cursors are left
#     out.  Old frames are dropped once they need more than 64 MB.
#
# @console: console index (a number) or device id (a string)
#     (default: the default console)
#
# @count: at most this many frames, up to 100 (default: 20)
#
# @thumbnails: small pictures of the first this many frames listed,
#     up to 5 (default: 0)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-read-only: does not change the VM
#
# Since: 11.2
##
{ 'command': 'frames',
  'data': { '*console': 'any', '*count': 'int', '*thumbnails': 'int' },
  'returns': 'McpFramesResult',
  'features': [ 'mcp', 'mcp-read-only' ],
  'if': 'CONFIG_PIXMAN' }

##
# @McpDebugMemory:
#     Guest memory that a debug tool shows when the CPU stops.
#
# @address: the first address: hex with 0x, or decimal, or a symbol
#     that @debug-symbols loaded.  It may add and take away registers
#     of the CPU that stopped, with their values then: sp, sp+16,
#     r30-0x20, or 0x657500000000+r26 when a register holds only the
#     offset in a space or a segment; and symbols: jiffies,
#     proc_table+0x40.  The register names are GDB's (an unknown one
#     gets the list), and a name that is a register is not taken for a
#     symbol; pc is where the CPU is.  CPUs whose registers have no
#     names there (alpha, hppa, mips) take rN, GDB's register N, which
#     on most CPUs is the general register N.
#
# @words: how many 32-bit words, up to 256 (default: 8)
#
# @physical: a physical address; otherwise a virtual one, through the
#     MMU of the CPU that stopped (default: false)
#
# @string: show a C string there instead, up to its zero byte or 256
#     bytes; @words does not count then (default: false)
#
# Since: 11.2
##
{ 'struct': 'McpDebugMemory',
  'data': { 'address': 'str', '*words': 'int', '*physical': 'bool',
            '*string': 'bool' },
  'if': 'CONFIG_TCG' }

##
# @McpDebugStop:
#     Where a debug tool left the CPU.  The summary shows the next
#     instruction, the registers and the memory asked for.
#
# @reached: a CPU got to an address or touched watched memory as
#     often as asked (debug-run), or the CPU did all its steps
#     (debug-step)
#
# @cpu: the CPU, when one stopped; after a device's write, the one
#     shown
#
# @pc: its program counter, in hex
#
# @symbol: where @pc is, as a symbol and an offset (panic+0x1c), when
#     @debug-symbols loaded one there
#
# @hits: how often a CPU got to an address or touched watched memory
#     (debug-run)
#
# @skipped: hits that did not meet the condition (debug-run with
#     @condition)
#
# @steps: instructions done (debug-step)
#
# @running: the VM is still running
#
# @retry: true when this arrival may be the CPU coming back to run the
#     instruction again (debug-run): when a debug tool last took this
#     CPU on from the address, the instruction took an interruption
#     first, such as a TLB miss or a page fault, and the CPU came back
#     soon after.  Run debug-run again to go on.
#
# @watch: what the CPU or a device did to the watched memory, when
#     that stopped the VM (debug-run)
#
# @exception: the exception the CPU took, when that stopped the VM
#     (debug-run)
#
# @history: how the CPU got there (debug-run with @history): the last
#     blocks of code it ran, oldest first, each as start-end in hex,
#     with " xN" when it ran N times in a row
#
# Since: 11.2
##
{ 'struct': 'McpDebugStop',
  'base': 'McpResult',
  'data': { 'reached': 'bool', '*cpu': 'int', '*pc': 'str',
            '*symbol': 'str',
            '*hits': 'int', '*skipped': 'int', '*steps': 'int',
            'running': 'bool',
            '*retry': 'bool', '*watch': 'McpWatchHit',
            '*exception': 'McpExceptionHit', '*history': [ 'str' ] },
  'if': 'CONFIG_TCG' }

##
# @McpWatchAccess:
#     What a CPU does to watched memory to stop the VM.
#
# @write: writes to it
#
# @read: reads it
#
# @access: reads or writes it
#
# Since: 11.2
##
{ 'enum': 'McpWatchAccess',
  'data': [ 'write', 'read', 'access' ],
  'if': 'CONFIG_TCG' }

##
# @McpWatch:
#     Memory to watch (a data watchpoint).
#
# @address: the first byte: a virtual address as the CPU sees it,
#     written like a @McpDebugMemory address; registers in it need the
#     VM stopped
#
# @length: how many bytes, up to 4096 (default: 4)
#
# @access: what stops the VM (default: write)
#
# @physical: @address is physical, as hmp's xp reads it: CPUs'
#     accesses are caught through any virtual address that maps it,
#     as found by memory-search (default: false)
#
# @space: @address is in this address space, named as hmp's "info
#     mtree" names it, such as "I/O" for the I/O ports of x86 and PCI
#     machines: to watch a device's registers there.  Each access is
#     seen, whoever makes it.  Where a CPU sees that space in its own
#     memory, as through an I/O window, the CPU stops right after the
#     instruction that did it; elsewhere, as for x86's in and out, at
#     the end of its block of code.  The CPU's own memory space is the
#     same as @physical.
#
# @devices: also stop when no CPU does it: when a device writes to it
#     itself (DMA), or QEMU writes to it for a CPU, as some CPUs do
#     for their page tables; and for a device's registers, when a
#     device or QEMU reads or writes them.  Devices' reads of RAM are
#     not seen.  The memory is watched where its pages were mapped as
#     the call began (default: true)
#
# Since: 11.2
##
{ 'struct': 'McpWatch',
  'data': { 'address': 'str', '*length': 'int',
            '*access': 'McpWatchAccess', '*physical': 'bool',
            '*space': 'str', '*devices': 'bool' },
  'if': 'CONFIG_TCG' }

##
# @McpAddresses:
#     One code address, or several.
#
# @one: an address
#
# @several: a list of addresses
#
# Since: 11.2
##
{ 'alternate': 'McpAddresses',
  'data': { 'one': 'str', 'several': [ 'str' ] },
  'if': 'CONFIG_TCG' }

##
# @McpWatches:
#     Memory to watch: one area, or several.
#
# @one: an area
#
# @several: a list of areas
#
# Since: 11.2
##
{ 'alternate': 'McpWatches',
  'data': { 'one': 'McpWatch', 'several': [ 'McpWatch' ] },
  'if': 'CONFIG_TCG' }

##
# @McpExceptions:
#     The exceptions a debug tool stops at or logs.  An exception is a
#     trap or a fault that a CPU takes: it notes where it was and goes
#     to the guest's handler for it, as for a page fault, a TLB miss,
#     an illegal instruction, a divide by zero, a breakpoint
#     instruction or a system call.  Interrupts from devices are not
#     exceptions.  The numbers are QEMU's for the CPU, not names:
#     debug-trace with @exception {} shows which ones a guest takes,
#     and how often.
#
# @numbers: only these, up to 32 (default: all)
#
# @skip: all but these, up to 32, such as the ones a guest takes all
#     the time (default: none)
#
# Since: 11.2
##
{ 'struct': 'McpExceptions',
  'data': { '*numbers': [ 'int' ], '*skip': [ 'int' ] },
  'if': 'CONFIG_TCG' }

##
# @McpExceptionHit:
#     An exception a CPU took.
#
# @number: QEMU's number for it
#
# @pc: the instruction that took it, in hex
#
# @handler: where the CPU went, in hex: the first instruction of the
#     guest's handler
#
# Since: 11.2
##
{ 'struct': 'McpExceptionHit',
  'data': { 'number': 'int', 'pc': 'str', 'handler': 'str' },
  'if': 'CONFIG_TCG' }

##
# @McpExceptionCount:
#     How often CPUs took an exception (@debug-trace).
#
# @number: QEMU's number for it
#
# @count: how often
#
# @handler: where the CPU went the first time, in hex
#
# Since: 11.2
##
{ 'struct': 'McpExceptionCount',
  'data': { 'number': 'int', 'count': 'int', 'handler': 'str' },
  'if': 'CONFIG_TCG' }

##
# @McpDeviceWrite:
#     An access to watched memory that no CPU did: a device's write to
#     RAM (DMA), QEMU's for a CPU, or a device's or QEMU's access to a
#     device's registers.
#
# @physical: the physical address of the first watched byte it
#     touched, in hex; none in another address space
#
# @length: how many bytes that one access touched in all; it may have
#     touched more than the watched memory
#
# @from: "cpu" when it came during an I/O access by CPU @cpu, or QEMU
#     wrote for that CPU (as for a page table); "main-loop" for a
#     device on its own, as when a timer fires or a disk or network
#     transfer ends; "io-thread"; or "other-thread"
#
# @cpu: the CPU, with "cpu"
#
# Since: 11.2
##
{ 'struct': 'McpDeviceWrite',
  'data': { '*physical': 'str', 'length': 'int', 'from': 'str',
            '*cpu': 'int' },
  'if': 'CONFIG_TCG' }

##
# @McpWatchHit:
#     What a CPU or a device did to watched memory.
#
# @address: the first watched byte it touched, in hex
#
# @physical: @address is physical
#
# @space: the address space of @address, when the watch named one
#
# @access: "read" or "write"
#
# @pc: the instruction that did it, in hex; the CPU has run it.  None
#     when a device did it, or with @block-end.
#
# @block-end: true when a CPU did it but no watchpoint caught the
#     instruction, as for x86's in and out: the CPU stopped at the end
#     of its block of code, right after the instruction that did it or
#     a few instructions on
#
# @device: who did it, when no CPU did
#
# @value: for a device's registers, the value read or written, in hex
#
# @size: for a device's registers, how many bytes the access had
#
# @region: for a device's registers, the memory region they are in, as
#     "info mtree" names it, and in brackets the type of the device
#     that has it
#
# @offset: for a device's registers, where the access was in @region,
#     in hex: which register
#
# Since: 11.2
##
{ 'struct': 'McpWatchHit',
  'data': { 'address': 'str', '*physical': 'bool', '*space': 'str',
            'access': 'str', '*pc': 'str', '*block-end': 'bool',
            '*device': 'McpDeviceWrite', '*value': 'str', '*size': 'int',
            '*region': 'str', '*offset': 'str' },
  'if': 'CONFIG_TCG' }

##
# @debug-run:
#     Let the guest run until a CPU gets to an address (a breakpoint),
#     touches watched memory, or takes an exception, then stop the VM
#     and show where it is, the registers and any @memory.  Use it
#     instead of a GDB script.  The VM stays stopped: look around with
#     hmp, go on with debug-step or another debug-run, or resume it
#     with vm-power.  A CPU that is stopped at one of the addresses
#     when the call begins first steps past it, so the call stops at
#     the next arrival.
#
# @address: where to stop: hex with 0x, or decimal, or a symbol that
#     @debug-symbols loaded (panic, panic+0x1c), or a list of up to 64
#     of them, to stop at whichever a CPU gets to first.  A virtual
#     address as the CPU sees it (on x86 the linear address: CS base
#     plus EIP).  Give it, @watch, @exception, or more of them.
#
# @address-mask: compare only the bits of each address that are set
#     in this number, written as an address: a CPU stops at any
#     address with the same bits there.  Where the top bits of an
#     address name a space, as on PA-RISC, 0xffffffff stops in every
#     space, so in every process.  The guest runs one instruction at a
#     time in each page that matches, so a mask with few bits slows it
#     down (default: all bits)
#
# @watch: stop after a CPU writes or reads this memory, with the
#     instruction that did it; or a list of up to 16 such areas.  A
#     device that writes to it itself (DMA) stops the VM too, right
#     after the write, unless @devices is false: the summary says
#     where the write came from, and the CPU shown is the one whose
#     I/O access it came in, if any.  For a device's registers, in
#     memory or in a @space such as the I/O ports, the summary also
#     gives the value read or written and which device and register
#     it was; their memory is not read, as a read may change the
#     device.
#
# @exception: stop right after a CPU takes one of these exceptions,
#     at the first instruction of the guest's handler; the summary
#     shows the instruction that took it.  {} stops at any: to catch
#     a crash, an illegal instruction or a trap the guest does not
#     expect.
#
# @condition: count a hit only when this holds, such as "eax == 5"
#     or "cr3 == 0x1f000 && u32[esp+4] != 0": to stop in one process,
#     or for one device.  It is worked out where the CPU would stop:
#     at the address, after the access to the watched memory, or at
#     the first instruction of the exception's handler.  It takes
#     numbers (hex with 0x, or decimal), registers (named as in a
#     @memory address), symbols from @debug-symbols (their
#     addresses), memory as the CPU sees it with u8[...], u16[...],
#     u32[...] or u64[...], the low bits of a value with u8(...) to
#     u64(...), and C's operators, on 64-bit numbers.  They are
#     unsigned; s8 to s64 in place of u8 to u64 extend the sign and
#     make them signed, as in "s32(eax) < 0", and a comparison, /, %
#     or >> with a signed side works signed.  The CPU works it out
#     itself at each hit, so a hit where it is false does not stop
#     the VM.  A device's write stops it for a moment: the condition
#     is worked out then, with the registers of the CPU the summary
#     would show.  A hit where it can't be worked out, as when its
#     memory can't be read, counts as false; the summary says why.
#
# @hits: stop at this arrival, watched access or exception, counting
#     from 1; with @condition, only the ones that meet it count
#     (default: 1)
#
# @cpu: watch only this CPU (default: all)
#
# @memory: guest memory to show when it stops
#
# @history: note the last this many blocks of code each CPU runs, up
#     to 1024, and show them when it stops: how the CPU got there.  A
#     block is the code from where a jump lands to the next jump.  The
#     guest runs slower while they are noted (default: 0, none)
#
# @timeout-ms: give up after this long, at most 1500000, 25 minutes
#     (default: 30000); the VM then keeps running
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'debug-run',
  'data': { '*address': 'McpAddresses', '*address-mask': 'str',
            '*watch': 'McpWatches', '*exception': 'McpExceptions',
            '*condition': 'str', '*hits': 'int',
            '*cpu': 'int', '*memory': [ 'McpDebugMemory' ],
            '*history': 'int', '*timeout-ms': 'int' },
  'returns': 'McpDebugStop',
  'features': [ 'mcp' ],
  'coroutine': true,
  'if': 'CONFIG_TCG' }

##
# @McpTraceEntry:
#     One hit that @debug-trace lists.
#
# @hit: its number, counting from 1
#
# @cpu: the CPU; for a device's write, the one whose registers are
#     logged
#
# @pc: the address it got to, or the instruction that touched the
#     watched memory or took the exception, in hex; for a device's
#     write, where the CPU was
#
# @watch: what it or a device did to the watched memory, when that was
#     the hit
#
# @value: for a device's registers, the value read or written; else
#     the watched word after that, in hex
#
# @exception: the exception it took, when that was the hit; the
#     registers and memory are those at the handler
#
# @retry: true when the CPU may be back to run the instruction again,
#     after it took an interruption there (see @McpDebugStop)
#
# @values: the registers and memory asked for, as text, in order
#
# Since: 11.2
##
{ 'struct': 'McpTraceEntry',
  'data': { 'hit': 'int', 'cpu': 'int', 'pc': 'str',
            '*watch': 'McpWatchHit', '*value': 'str',
            '*exception': 'McpExceptionHit', '*retry': 'bool',
            '*values': [ 'str' ] },
  'if': 'CONFIG_TCG' }

##
# @McpTraceInstruction:
#     An instruction that touched the watched memory or took an
#     exception, or, with several addresses or an address mask, one
#     that CPUs got to (@debug-trace).
#
# @pc: its address, in hex
#
# @count: how often it did, or how often CPUs got there
#
# @instruction: the instruction, as it was the first time it could be
#     read
#
# @block-end: true when no watchpoint caught these accesses (see
#     @McpWatchHit): @pc is where the CPU's block of code that did
#     them ended, and the instruction is in that block
#
# Since: 11.2
##
{ 'struct': 'McpTraceInstruction',
  'data': { 'pc': 'str', 'count': 'int', '*instruction': 'str',
            '*block-end': 'bool' },
  'if': 'CONFIG_TCG' }

##
# @McpTraceRegister:
#     A device's register that watched accesses went to, and how often
#     (@debug-trace).
#
# @address: the first watched byte the first of them touched, in hex,
#     as the watch has it
#
# @region: the memory region of the register, named as in
#     @McpWatchHit; none where nothing is
#
# @offset: where the accesses were in @region, in hex
#
# @access: "read" or "write"
#
# @count: how often
#
# @value: the value the last one read or wrote, in hex
#
# Since: 11.2
##
{ 'struct': 'McpTraceRegister',
  'data': { 'address': 'str', '*region': 'str', '*offset': 'str',
            'access': 'str', 'count': 'int', 'value': 'str' },
  'if': 'CONFIG_TCG' }

##
# @McpTrace:
#     What @debug-trace returns.
#
# @hits: the hits it saw
#
# @skipped: hits it left out because they did not meet the condition
#     (with @condition)
#
# @device-writes: of the hits, the ones no CPU did: devices' writes,
#     and their accesses to registers (with @watch)
#
# @ms: how long it traced, in milliseconds
#
# @running: the VM is running
#
# @instructions: when memory was watched, the instructions that
#     touched it, most first; with exceptions, the instructions that
#     took them; with several addresses or an address mask, also each
#     address the CPUs got to
#
# @exceptions: when exceptions were traced, how often CPUs took each
#     one, most first
#
# @device-registers: when watched memory has a device's registers,
#     how often each register was read and written, most first
#
# @entries: the hits it lists
#
# Since: 11.2
##
{ 'struct': 'McpTrace',
  'base': 'McpResult',
  'data': { 'hits': 'int', '*skipped': 'int', '*device-writes': 'int',
            'ms': 'int',
            'running': 'bool',
            '*instructions': [ 'McpTraceInstruction' ],
            '*exceptions': [ 'McpExceptionCount' ],
            '*device-registers': [ 'McpTraceRegister' ],
            'entries': [ 'McpTraceEntry' ] },
  'if': 'CONFIG_TCG' }

##
# @debug-trace:
#     Log each time a CPU gets to an address (a breakpoint), touches
#     watched memory or takes an exception, with the registers and
#     memory asked for, and let the guest go on.  For watched memory
#     it also counts which instructions touched it: use it to find
#     what overwrites something.  Each hit stops the VM for a moment,
#     so a busy address slows the guest down while it traces.  It ends
#     after @count hits or @duration-ms, and the guest keeps running.
#
# @address: log arrivals here, or at each address of a list, written
#     as for debug-run.  Give it, @watch, @exception, or more of them.
#
# @address-mask: compare only these bits of each address, as for
#     debug-run
#
# @watch: log the accesses to this memory, or to each area of a list,
#     with the instruction that did each one, and devices' writes to
#     it, as for debug-run.  For a device's registers it also counts
#     the accesses by register, with the last value: use it to see
#     what a driver does to its device.
#
# @exception: log these exceptions as CPUs take them, and count them
#     by number and by the instruction that took them; {} for all.
#     Use it to learn which ones a guest takes, and how often, before
#     debug-run stops at a rare one.
#
# @condition: log and count a hit only when this holds, written as
#     for debug-run.  The CPU works it out itself, so a hit where it
#     is false does not stop the VM.
#
# @count: stop after this many hits, up to 100000 (default: 1000)
#
# @list: list this many hits in full, up to 500; after them, only the
#     first access to the watched memory or exception by each new
#     instruction, and with several addresses or @address-mask the
#     first arrival at each new address (default: 20)
#
# @cpu: trace only this CPU (default: all)
#
# @registers: registers to log at each hit listed, up to 16, named as
#     in a @McpDebugMemory address
#
# @memory: memory to log at each hit listed; @words is 1 unless given
#
# @duration-ms: trace for at most this long, at most 1500000, 25
#     minutes (default: 10000)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'debug-trace',
  'data': { '*address': 'McpAddresses', '*address-mask': 'str',
            '*watch': 'McpWatches', '*exception': 'McpExceptions',
            '*condition': 'str', '*count': 'int',
            '*list': 'int', '*cpu': 'int', '*registers': [ 'str' ],
            '*memory': [ 'McpDebugMemory' ], '*duration-ms': 'int' },
  'returns': 'McpTrace',
  'features': [ 'mcp' ],
  'coroutine': true,
  'if': 'CONFIG_TCG' }

##
# @debug-step:
#     Run one CPU for some instructions, one at a time, and show each
#     one, then the next instruction and the registers.  The other
#     CPUs stay stopped and interrupts wait.  A running VM is stopped
#     first.
#
# @count: how many instructions, up to 10000; the last 200 are shown
#     (default: 1)
#
# @cpu: the CPU (default: the one that stopped last, else the first)
#
# @memory: guest memory to show after the last step
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'debug-step',
  'data': { '*count': 'int', '*cpu': 'int',
            '*memory': [ 'McpDebugMemory' ] },
  'returns': 'McpDebugStop',
  'features': [ 'mcp' ],
  'coroutine': true,
  'if': 'CONFIG_TCG' }

##
# @McpProfileEntry:
#     One program counter in a profile.
#
# @pc: the address, in hex
#
# @count: samples at it
#
# @percent: its share of the samples in which a CPU ran, rounded
#
# @physical: the physical address of the code there, in hex, as the
#     CPU mapped it when it was sampled; the same @pc in two processes
#     is two entries.  Missing when the CPU had no mapping for it.
#
# @instruction: the instruction there, read at @physical when there
#     is one, as the mapping may have changed since
#
# @symbol: @pc as a symbol and an offset (idle+0x8), when
#     @debug-symbols loaded one there
#
# Since: 11.2
##
{ 'struct': 'McpProfileEntry',
  'data': { 'pc': 'str', 'count': 'int', 'percent': 'int',
            '*physical': 'str', '*instruction': 'str', '*symbol': 'str' },
  'if': 'CONFIG_TCG' }

##
# @McpProfile:
#     What @debug-profile returns.
#
# @interval-ms: how long it sampled
#
# @samples: samples taken, of all the CPUs sampled
#
# @halted-percent: share of the samples in which the CPU was halted
#
# @paused-percent: share of the time in which the VM was paused
#
# @top: the program counters seen most, most first
#
# Since: 11.2
##
{ 'struct': 'McpProfile',
  'base': 'McpResult',
  'data': { 'interval-ms': 'int', 'samples': 'int',
            'halted-percent': 'int', 'paused-percent': 'int',
            'top': [ 'McpProfileEntry' ] },
  'if': 'CONFIG_TCG' }

##
# @debug-profile:
#     Sample for a while where the CPUs run, and list the program
#     counters seen most, with their instructions.  This finds idle
#     loops and hot spots.  A sample is the address where a CPU goes
#     on, which is the start of a block of translated code, so a loop
#     shows at its start.  The guest keeps running.
#
# @interval-ms: how long to sample, from 100 to 1500000 (default:
#     5000)
#
# @cpu: sample only this CPU (default: all)
#
# @top: list this many addresses, up to 100 (default: 20)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-read-only: does not change the VM
#
# Since: 11.2
##
{ 'command': 'debug-profile',
  'data': { '*interval-ms': 'int', '*cpu': 'int', '*top': 'int' },
  'returns': 'McpProfile',
  'features': [ 'mcp', 'mcp-read-only' ],
  'coroutine': true,
  'if': 'CONFIG_TCG' }

##
# @McpCoverageAction:
#     What @debug-coverage does.
#
# @start: record the code that runs anyway (@quiet-ms), then begin
#     recording the code that runs
#
# @stop: stop recording, and list the code that ran
#
# Since: 11.2
##
{ 'enum': 'McpCoverageAction',
  'data': [ 'start', 'stop' ],
  'if': 'CONFIG_TCG' }

##
# @McpCoverageRange:
#     Blocks of code close together in memory, all on the list.
#
# @address: where the first of them starts: the address the CPU ran
#     it at, in hex
#
# @end: the last byte of the last of them, in hex
#
# @physical: @address as a physical address, when the code is in RAM
#     or ROM
#
# @symbol: @address as a symbol and an offset (jiffies+0x8), when
#     @debug-symbols loaded one there
#
# @blocks: how many blocks of code
#
# @runs: how many times the CPUs ran them, all told, while it recorded
#     (with @refine and @ran false: in the recording before)
#
# Since: 11.2
##
{ 'struct': 'McpCoverageRange',
  'data': { 'address': 'str', 'end': 'str', '*physical': 'str',
            '*symbol': 'str', 'blocks': 'int', 'runs': 'int' },
  'if': 'CONFIG_TCG' }

##
# @McpCoverage:
#     What @debug-coverage returns.
#
# @recording: whether the CPUs note the code they run now
#
# @milliseconds: how long the quiet part took (start), or how long it
#     recorded (stop)
#
# @ran: how many blocks of code ran in the quiet part (start), or
#     while it recorded (stop)
#
# @quiet: with stop: how many of the blocks that ran had run in the
#     quiet part too; they are not on the list
#
# @blocks: with stop: how many blocks are on the list now
#
# @ranges: with stop: the blocks on the list, as ranges of code close
#     together, by address, up to @max
#
# Since: 11.2
##
{ 'struct': 'McpCoverage',
  'base': 'McpResult',
  'data': { 'recording': 'bool', '*milliseconds': 'int', '*ran': 'int',
            '*quiet': 'int', '*blocks': 'int',
            '*ranges': [ 'McpCoverageRange' ] },
  'if': 'CONFIG_TCG' }

##
# @debug-coverage:
#     Find the code that runs for one thing the guest does, such as
#     handling a click, a key or a command.  Call it with start, do
#     the thing (with the other tools), then call it with stop.  Start
#     first records a quiet part, in which you do nothing, to learn
#     the code that runs anyway (idle loops, timers, a blinking
#     cursor); stop leaves that code out and lists the rest: the
#     blocks of code that ran, as ranges by address.  To narrow the
#     list down, record again and stop with @refine: do the same thing
#     again and keep the blocks that ran again, or do something else
#     (or nothing) and drop the blocks that ran (@ran false).  The
#     guest runs slower while it records, and recording stops by
#     itself after 10 minutes.  To stop at a block, give its address
#     to debug-run.
#
# @action: start or stop
#
# @quiet-ms: with start: how long the quiet part takes, in
#     milliseconds; 0 for none.  The VM must run.  (default: 2000, at
#     most 60000)
#
# @refine: with stop: look only at the blocks on the list that the
#     stop before made (or kept), and keep the ones that ran while it
#     recorded (see @ran).  (default: false)
#
# @ran: with @refine: true keeps the blocks on the list that ran
#     while it recorded, and not in its quiet part; false keeps the
#     ones that did not run at all (default: true)
#
# @max: with stop: list this many ranges, up to 500 (default: 20)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# Since: 11.2
##
{ 'command': 'debug-coverage',
  'data': { 'action': 'McpCoverageAction', '*quiet-ms': 'int',
            '*refine': 'bool', '*ran': 'bool', '*max': 'int' },
  'returns': 'McpCoverage',
  'features': [ 'mcp' ],
  'coroutine': true,
  'if': 'CONFIG_TCG' }

##
# @McpMemoryWriteResult:
#     What @memory-write returns.
#
# @before: the bytes before, in hex
#
# @after: the bytes now, in hex
#
# Since: 11.2
##
{ 'struct': 'McpMemoryWriteResult',
  'base': 'McpResult',
  'data': { 'before': 'str', 'after': 'str' } }

##
# @memory-write:
#     Write bytes to guest RAM or ROM, for example to patch code or a
#     variable.  Devices are never written.  It returns the old bytes,
#     so you can put them back.  To read memory, use hmp ('x', 'xp').
#
# @address: where to write: hex with 0x, or decimal, or a symbol that
#     @debug-symbols loaded (panic, panic+0x1c)
#
# @bytes: the bytes in memory order, in hex, like "08000240" or
#     "de ad be ef", up to 1024.  A big-endian guest (HP-UX, SunOS,
#     AIX) stores the word 0x12345678 as "12345678", a little-endian
#     one (x86, Windows NT) as "78563412".
#
# @physical: a physical address; otherwise a virtual one, through the
#     CPU's MMU (default: false)
#
# @cpu: the CPU whose MMU translates a virtual address (default: the
#     one that stopped last, else the first)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-destructive: changes guest memory
#
# Since: 11.2
##
{ 'command': 'memory-write',
  'data': { 'address': 'str', 'bytes': 'str', '*physical': 'bool',
            '*cpu': 'int' },
  'returns': 'McpMemoryWriteResult',
  'features': [ 'mcp', 'mcp-destructive' ] }

##
# @McpMemoryMatch:
#     A place where @memory-search found the bytes.
#
# @address: where they start, in hex: physical, unless the search was
#     in virtual memory
#
# @physical: the physical address, in hex, when @address is virtual
#
# @region: the RAM or ROM it is in, as QEMU calls it, such as "pc.ram"
#
# @bytes: 16 bytes from there (32 with @wide), in hex; fewer where
#     RAM or ROM ends
#
# @text: those bytes as text, with a dot for each one that is not a
#     printable character; with @wide, as 16-bit characters
#
# @symbol: a virtual @address as a symbol and an offset (jiffies),
#     when @debug-symbols loaded one there
#
# @before: with @refine, what the place held at the last search, in
#     hex
#
# Since: 11.2
##
{ 'struct': 'McpMemoryMatch',
  'data': { 'address': 'str', '*physical': 'str', 'region': 'str',
            'bytes': 'str', 'text': 'str', '*symbol': 'str',
            '*before': 'str' } }

##
# @McpMemorySearchResult:
#     What @memory-search returns.
#
# @matches: where it found them, in address order
#
# @count: how many it found, counting up to 100000; more than listed
#     when there were more than @max.  With @refine, how many places
#     it kept.
#
# @searched: how many bytes it looked at
#
# @places: with @refine, how many places it looked at: the ones the
#     last search found or kept
#
# Since: 11.2
##
{ 'struct': 'McpMemorySearchResult',
  'base': 'McpResult',
  'data': { 'matches': [ 'McpMemoryMatch' ], 'count': 'int',
            'searched': 'int', '*places': 'int' } }

##
# @memory-search:
#     Find bytes or text in guest memory: a message a program shows, a
#     value a variable holds, a structure with a known signature.  It
#     reads RAM and ROM, never devices.  The guest may run while it
#     searches, and change the memory under it: pause it first
#     (vm-power) to see one moment.  To read what is around a match,
#     use hmp ('xp', or 'x' for a virtual address).  To find a
#     variable, such as a counter or a flag: search for its value, let
#     it change in the guest, then search for the new value with
#     @refine.
#
# @bytes: the bytes in memory order, in hex, like "de ad be ef", up to
#     256.  A big-endian guest (HP-UX, SunOS, AIX) stores the word
#     0x12345678 as "12345678", a little-endian one (x86, Windows NT)
#     as "78563412".  Give it, @text or @value.
#
# @text: text to find, up to 256 bytes (128 characters with @wide)
#
# @value: a number to find as the guest keeps it: @size bytes, in the
#     byte order the CPU runs in.  Decimal, hex with 0x, or negative.
#
# @size: how many bytes @value takes: 1, 2, 4 or 8 (default: 4)
#
# @refine: look only at the places the last search found (or kept),
#     and keep those that hold @bytes, @text or @value now.  With none
#     of them, keep the places whose bytes changed since (see
#     @changed).  The next @refine looks at the places this one kept.
#     It takes no @address, @length, @physical or @cpu: each place is
#     as the last search found it.  (default: false)
#
# @changed: with @refine and nothing to find: true keeps the places
#     whose bytes changed, false the ones whose bytes did not
#     (default: true)
#
# @wide: find @text as 16-bit characters (UTF-16) in the byte order
#     the CPU runs in, as Windows NT keeps most of its strings
#     (default: false)
#
# @ignore-case: letters A to Z in @text match in either case
#     (default: false)
#
# @address: search from here on: hex with 0x, or decimal, or a symbol
#     that @debug-symbols loaded; a virtual address through the CPU's
#     MMU, unless @physical.  Without it, it searches all RAM and ROM
#     by physical address.
#
# @length: how many bytes from @address (default: 1048576, 1 MiB);
#     virtual memory at most 4 GiB at a time
#
# @physical: @address is a physical address (default: false)
#
# @cpu: the CPU whose MMU maps a virtual @address (default: the one
#     that stopped last, else the first)
#
# @max: list at most this many matches, up to 500; 0 only counts them
#     (default: 20)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-read-only: does not change the VM
#
# Since: 11.2
##
{ 'command': 'memory-search',
  'data': { '*bytes': 'str', '*text': 'str', '*value': 'str',
            '*size': 'int', '*wide': 'bool', '*ignore-case': 'bool',
            '*refine': 'bool', '*changed': 'bool', '*address': 'str',
            '*length': 'size', '*physical': 'bool', '*cpu': 'int',
            '*max': 'int' },
  'returns': 'McpMemorySearchResult',
  'features': [ 'mcp', 'mcp-read-only' ],
  'coroutine': true }

##
# @McpSymbols:
#     What @debug-symbols did.
#
# @loaded: symbols it added in this call
#
# @count: symbols there are now
#
# @skipped: lines it left out: ones it did not understand, undefined
#     symbols, and symbols it had already
#
# @lookups: the answer to each @lookup, in order, such as
#     "panic = 0x80123400 (T, 0x120 bytes)" or "0x80123456 =
#     panic+0x56"
#
# Since: 11.2
##
{ 'struct': 'McpSymbols',
  'base': 'McpResult',
  'data': { 'loaded': 'int', 'count': 'int', 'skipped': 'int',
            '*lookups': [ 'str' ] } }

##
# @debug-symbols:
#     Load names for guest addresses, such as the functions and
#     variables of a kernel, from a symbol list.  Then the debug
#     tools take a name wherever they take an address (panic,
#     panic+0x1c, jiffies), and show the name next to the addresses
#     they print, also in disassembly (and in hmp's x /i).  Get the
#     list from nm in the guest or on the host, from a System.map, or
#     from a link map.  Its addresses are virtual ones, as the
#     guest's MMU maps them.  The names stay until @clear, also when
#     the guest reboots.  With no arguments, it says how many there
#     are.
#
#     Each line is one symbol: "ADDR TYPE NAME" (BSD nm,
#     System.map), "ADDR SIZE TYPE NAME" (nm -S), "NAME TYPE ADDR
#     [SIZE]" (nm -P), "ADDR NAME", "NAME ADDR", a line of a System V
#     nm table ("[45] | 0x10004000 | 0x120 | FUNC | GLOB | ... |
#     panic", or the HP-UX one, "panic | 0x00012345 | extern | entry
#     | $CODE$"), or a line of a Microsoft link map ("0001:00000a10
#     _main 00401a10 f main.obj").  Addresses are hex, with or
#     without 0x; System V nm prints decimal unless given -x.  TYPE is
#     nm's letter: undefined symbols (U) are left out, and absolute
#     ones (A) are found by name but never shown for an address.
#     Other lines are skipped.
#
#     A name finds that symbol, else _name, else .name (a.out, COFF
#     and AIX put those in front).  Where code is wanted, as for a
#     breakpoint, a function goes before data of the same name.
#
#     A 64-bit CPU that runs a 32-bit system may extend addresses
#     with the sign, as MIPS and Alpha do: 0x80123400 in the list is
#     0xffffffff80123400 there.  The tools see that by themselves, so
#     give the list as it is.
#
#     In disassembly, a jump or a call gets the name of the place it
#     goes to, also inside a function (panic+0x1c); other
#     instructions get a name only for a symbol's own address.
#
# @file: a file on the host with the list
#
# @text: the list itself, one symbol to a line
#
# @base: add this to each address in the list, as for a module or a
#     DLL loaded somewhere else than the list says: hex with 0x, or
#     decimal (default: 0)
#
# @clear: forget the symbols loaded before (default: false)
#
# @lookup: up to 64 names or addresses to look up, after loading
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-read-only: does not change the VM
#
# Since: 11.2
##
{ 'command': 'debug-symbols',
  'data': { '*file': 'str', '*text': 'str', '*base': 'str',
            '*clear': 'bool', '*lookup': [ 'str' ] },
  'returns': 'McpSymbols',
  'features': [ 'mcp', 'mcp-read-only' ] }

##
# @McpRegisterWriteResult:
#     What @register-write returns.
#
# @before: the value before, in hex
#
# @after: the value now, in hex
#
# Since: 11.2
##
{ 'struct': 'McpRegisterWriteResult',
  'base': 'McpResult',
  'data': { 'before': 'str', 'after': 'str' },
  'if': 'CONFIG_TCG' }

##
# @register-write:
#     Set a register of a CPU while the VM is stopped (by debug-run,
#     debug-step or vm-power pause), for example to change what a
#     function returns, or to go on at another instruction.  It
#     returns the old value, so you can put it back, and it says what
#     else changed with it.
#
# @register: pc, or a register named as in a @McpDebugMemory
#     address.  pc is where the CPU is, as the debug tools show it:
#     setting it changes the registers that hold it, such as a code
#     segment's offset or a next-instruction register, but never the
#     CPU's mode.  When it can't, nothing changes, and the error says
#     why.
#
# @value: the new value: hex with 0x, decimal, or a negative decimal
#     for a register of up to 8 bytes
#
# @cpu: the CPU (default: the one that stopped last, else the first)
#
# Features:
#
# @mcp: offered as an MCP tool
#
# @mcp-destructive: changes the CPU's registers
#
# Since: 11.2
##
{ 'command': 'register-write',
  'data': { 'register': 'str', 'value': 'str', '*cpu': 'int' },
  'returns': 'McpRegisterWriteResult',
  'features': [ 'mcp', 'mcp-destructive' ],
  'if': 'CONFIG_TCG' }
